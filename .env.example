# Local Ollama (default). No API key is needed.
# Defaults chosen by the model benchmark (TraceabilityApp/benchmark).
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
JUDGE_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434

# Thinking models (qwen3): false turns off the hidden reasoning pass.
# Keep extraction thinking off: with it on, extraction took hours instead of minutes.
# Leave JUDGE_THINK empty to use the model's default.
LLM_THINK=false
JUDGE_THINK=

# To use Grok instead, set LLM_PROVIDER=grok and provide your xAI API key.
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4
# XAI_API_KEY=your-api-key
